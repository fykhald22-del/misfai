<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>رفد – منصة تربط احتياجات المجتمع بالقدرات الجامعية</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;700&display=swap">
<style>
:root{--bg:#F5F7F6;--surface:#FFFFFF;--ink:#16263A;--muted:#5B6B7A;--line:#D5DDE0;--teal:#0E7C6B;--tealbg:#DDF1EC;--gold:#B8790A;--goldbg:#FBEBCB;--blue:#2B5C9E;--bluebg:#DFE9F6;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0F1A24;--surface:#17232F;--ink:#E8EEF2;--muted:#9AABB8;--line:#2A3A48;--teal:#4CC3AD;--tealbg:#143A34;--gold:#E8B14E;--goldbg:#3D2F12;--blue:#8DB4EA;--bluebg:#1B3050}}
:root[data-theme="dark"]{--bg:#0F1A24;--surface:#17232F;--ink:#E8EEF2;--muted:#9AABB8;--line:#2A3A48;--teal:#4CC3AD;--tealbg:#143A34;--gold:#E8B14E;--goldbg:#3D2F12;--blue:#8DB4EA;--bluebg:#1B3050}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"IBM Plex Sans Arabic",Tahoma,Arial,sans-serif;line-height:1.7;font-size:16px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--surface);z-index:10}
header{position:sticky;top:env(safe-area-inset-top,0px);background:var(--surface);border-bottom:1px solid var(--line);z-index:5}
.bar{max-width:1000px;margin:auto;padding:10px 16px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.logo{font-weight:700;font-size:26px;color:var(--teal);margin-inline-end:auto}
nav{display:flex;gap:4px;flex-wrap:wrap}
nav button{background:none;border:0;font:inherit;color:var(--muted);padding:6px 12px;border-radius:8px;cursor:pointer}
nav button[aria-current="true"]{background:var(--tealbg);color:var(--teal);font-weight:700}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
main{max-width:1000px;margin:auto;padding:24px 16px 48px}
h1{font-size:clamp(28px,5vw,42px);line-height:1.3;margin:0 0 12px}
h2{font-size:22px;margin:0 0 12px}
p{margin:0 0 12px}
.muted{color:var(--muted)}
.hero{display:grid;grid-template-columns:1fr;gap:20px}
.bridge{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:stretch;margin:20px 0}
.col{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px}
.col h3{margin:0 0 8px;font-size:15px;color:var(--muted);font-weight:500}
.need{border-inline-start:5px solid var(--gold)}
.cap{border-inline-start:5px solid var(--teal)}
.link{display:flex;align-items:center;font-size:28px;color:var(--teal)}
.tag{display:inline-block;padding:2px 10px;border-radius:99px;font-size:13px;background:var(--tealbg);color:var(--teal);margin:2px}
.tag.g{background:var(--goldbg);color:var(--gold)}.tag.b{background:var(--bluebg);color:var(--blue)}
.btn{font:inherit;font-weight:700;border:0;border-radius:10px;padding:10px 18px;background:var(--teal);color:#fff;cursor:pointer}
.btn.alt{background:var(--bluebg);color:var(--blue)}
.btn:disabled{opacity:.5;cursor:default}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:6px}
.card h3{margin:0;font-size:17px}
form{display:grid;gap:12px;max-width:560px}
label{display:grid;gap:4px;font-weight:500}
input,select,textarea{font:inherit;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink)}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.result{background:var(--tealbg);border-radius:12px;padding:14px;margin-top:8px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:20px}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px}
.stat b{font-size:30px;display:block;line-height:1.2}
.row{display:grid;grid-template-columns:120px 1fr 30px;gap:8px;align-items:center;margin:6px 0}
.track{background:var(--line);border-radius:6px;height:12px;overflow:hidden}
.fill{background:var(--teal);height:100%}
.toast{position:fixed;bottom:calc(16px + env(safe-area-inset-bottom,0px));inset-inline:16px;max-width:420px;margin:auto;background:var(--ink);color:var(--bg);padding:12px 16px;border-radius:10px;text-align:center}
.toast[hidden]{display:none}
@media (max-width:640px){.bridge{grid-template-columns:1fr}.link{justify-content:center;transform:rotate(90deg)}}
@media (prefers-reduced-motion:no-preference){.fill{transition:width .5s}}
.splash{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:24px;text-align:center;background:linear-gradient(180deg,var(--tealbg),var(--bg))}
.splash[hidden]{display:none}
.splash svg{width:min(320px,80vw);height:auto}
.splash h2{font-size:clamp(26px,6vw,38px);margin:0}
.splash .logo{font-size:44px;margin:0}
.splash{transition:opacity .9s ease;cursor:pointer}
.splash.out{opacity:0;pointer-events:none}
@media (prefers-reduced-motion:no-preference){.splash svg,.splash .logo,.splash h2{animation:rise 1.1s cubic-bezier(.22,.8,.3,1) both}.splash .logo{animation-delay:.35s}.splash h2{animation-delay:.7s}@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}}
#auth{position:fixed;inset:0;z-index:40;background:var(--bg);display:grid;grid-template-columns:1fr 1fr;overflow:auto}
#auth[hidden]{display:none}
.abrand{background:#0B4F46;color:#fff;padding:calc(48px + env(safe-area-inset-top,0px)) 48px 48px;display:flex;flex-direction:column;justify-content:center;gap:14px}
.abrand .lg{font-size:52px;font-weight:700;line-height:1.1}
.abrand h2{font-size:26px;margin:0}
.abrand ul{margin:8px 0 0;padding-inline-start:20px;line-height:2;opacity:.9}
.apane{display:flex;align-items:center;justify-content:center;padding:32px 20px}
.acard{width:100%;max-width:400px;display:grid;gap:14px}
.acard h1{font-size:28px;margin:0}
.acard form{max-width:none}
.alinks{display:flex;justify-content:space-between;gap:8px;font-size:15px}
.lnk{background:none;border:0;font:inherit;color:var(--blue);cursor:pointer;padding:2px 0;text-decoration:underline}
.sep{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:14px}.sep::before,.sep::after{content:"";flex:1;height:1px;background:var(--line)}
.aerr{color:#B3261E;font-size:15px;min-height:1.4em}
.aok{background:var(--tealbg);color:var(--teal);padding:12px;border-radius:10px}
.btn.wide{width:100%}.btn.ghost{background:none;border:1.5px solid var(--line);color:var(--ink)}
#who{display:flex;gap:8px;align-items:center;font-size:14px}.lo{font:inherit;font-size:14px;border:1px solid var(--line);background:none;color:var(--ink);border-radius:8px;padding:4px 10px;cursor:pointer}
@media (max-width:760px){#auth{grid-template-columns:1fr}.abrand{padding:calc(24px + env(safe-area-inset-top,0px)) 24px 24px}.abrand ul{display:none}.abrand .lg{font-size:36px}.abrand h2{font-size:20px}}
.abh{background:var(--tealbg);border-radius:16px;padding:32px 24px;margin-bottom:24px}.abh p{max-width:620px;font-size:18px;margin:0}
.ab2,.ab3{display:grid;gap:12px;margin-bottom:24px}.ab2{grid-template-columns:1fr 1fr}.ab3{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.ab4{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin:12px 0 28px}
.stp{background:var(--surface);border:1px solid var(--line);border-top:4px solid var(--teal);border-radius:12px;padding:14px}.stp i{font-style:normal;display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--teal);color:#fff;font-weight:700;margin-bottom:6px}
.ab2 .col h3,.ab3 .col h3{color:var(--ink);font-size:17px;font-weight:700}
@media (max-width:640px){.ab2{grid-template-columns:1fr}}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media (max-width:480px){.two{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="splash" id="splash" role="dialog" aria-label="مرحبًا بك في رفد">
<svg viewBox="0 0 320 200" role="img" aria-label="مبنى جامعي وكتب"><rect x="0" y="176" width="320" height="4" fill="var(--line)"/><polygon points="60,70 160,22 260,70" fill="var(--teal)"/><rect x="60" y="70" width="200" height="8" fill="var(--ink)"/><g fill="var(--surface)" stroke="var(--ink)" stroke-width="2"><rect x="74" y="82" width="16" height="72"/><rect x="108" y="82" width="16" height="72"/><rect x="142" y="82" width="16" height="72"/><rect x="176" y="82" width="16" height="72"/><rect x="210" y="82" width="16" height="72"/><rect x="236" y="82" width="14" height="72"/></g><rect x="54" y="154" width="212" height="8" fill="var(--ink)"/><rect x="44" y="162" width="232" height="8" fill="var(--muted)"/><circle cx="160" cy="54" r="8" fill="var(--gold)"/><g><rect x="278" y="150" width="34" height="8" fill="var(--gold)"/><rect x="282" y="142" width="30" height="8" fill="var(--blue)"/><rect x="280" y="134" width="32" height="8" fill="var(--teal)"/></g></svg>
<p class="logo">رفد</p>
<h2>احتياجات تنتظر من يرفدها</h2>
</div>
<div id="auth"><div class="abrand"><div class="lg">رفد</div><h2>احتياجات تنتظر من يرفدها</h2><ul><li>سجّل احتياج جهتك في دقائق</li><li>تبنَّ ما يناسب تخصصك</li><li>تابع الأثر حتى الإنجاز</li></ul></div><div class="apane"><div class="acard" id="abox"></div></div></div>
<header><div class="bar">
<div class="logo">رفد</div>
<nav aria-label="التنقل الرئيسي">
<button data-v="home">الرئيسية</button>
<button data-v="submit">سجّل احتياجًا</button>
<button data-v="browse">تصفّح الاحتياجات</button>
<button data-v="stats">المؤشرات</button>
<button data-v="about">عن رفد</button>
</nav><div id="who"></div></div></header>
<main id="app"></main>
<div class="toast" id="toast" role="status" hidden></div>
<script>
var CATS={"تقنية":{majors:["نظم المعلومات الإدارية","علوم الحاسب"],skills:["تطوير مواقع وتطبيقات","تحليل البيانات"],kw:["موقع","تطبيق","نظام","بيانات","إلكتروني","رقمي"]},
"تعليمية":{majors:["التربية","اللغات والترجمة"],skills:["تصميم المحتوى التعليمي","التدريس"],kw:["تعليم","دروس","تدريب","طلاب","قراءة","مهارات"]},
"صحية":{majors:["الصحة العامة","التمريض"],skills:["التوعية الصحية","الإسعافات الأولية"],kw:["صحة","صحي","توعية","مرضى","إسعاف"]},
"إدارية":{majors:["إدارة الأعمال","المحاسبة"],skills:["دراسات الجدوى","التخطيط المالي"],kw:["تمويل","ميزانية","تسويق","جمعية","إدارة","مشروع"]},
"بيئية":{majors:["العلوم البيئية","الهندسة"],skills:["دراسات الأثر البيئي","إعادة التدوير"],kw:["بيئة","نفايات","تدوير","زراعة","طاقة"]}};
var ST=["جديد","قيد التنفيذ","منجز"];
var seed=[
{id:1,entity:"جمعية إنسان الخيرية",title:"نظام إلكتروني لإدارة المتطوعين",desc:"نحتاج موقعًا لتسجيل المتطوعين وتوزيع المهام عليهم.",cat:"تقنية",st:0},
{id:2,entity:"مدرسة الأمل الابتدائية",title:"برنامج تقوية القراءة للصفوف الأولية",desc:"نبحث عن طلاب لإعداد دروس تقوية في القراءة.",cat:"تعليمية",st:1},
{id:3,entity:"مركز الحي الصحي",title:"حملة توعية بالسكري",desc:"حملة توعوية لسكان الحي بأعراض السكري والوقاية منه.",cat:"صحية",st:0},
{id:4,entity:"جمعية البر",title:"دراسة جدوى لمشروع أسر منتجة",desc:"نحتاج دراسة تمويل وتسويق لمشاريع الأسر المنتجة.",cat:"إدارية",st:2},
{id:5,entity:"بلدية المحافظة",title:"مبادرة فرز النفايات في الحي",desc:"مبادرة لتوعية السكان بفرز النفايات وإعادة التدوير.",cat:"بيئية",st:0}];
var LOC=[["جامعة القصيم","بريدة"],["جامعة القصيم","عنيزة"],["جامعة القصيم","الرس"],["جامعة القصيم","بريدة"],["جامعة الملك سعود","الرياض"]];
seed.forEach(function(n,i){n.uni=LOC[i][0];n.city=LOC[i][1]});
var needs=seed.slice();
try{var s=localStorage.getItem("rifd-needs");if(s){var p=JSON.parse(s);if(Array.isArray(p)&&p.length)needs=p}}catch(e){}
function save(){try{localStorage.setItem("rifd-needs",JSON.stringify(needs))}catch(e){}}
function esc(t){return String(t).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function classify(t){var best="",n=0;for(var c in CATS){var k=CATS[c].kw.filter(function(w){return t.indexOf(w)>-1}).length;if(k>n){n=k;best=c}}return best}
function toast(m){var t=document.getElementById("toast");t.textContent=m;t.hidden=false;clearTimeout(toast.h);toast.h=setTimeout(function(){t.hidden=true},2600)}
function tags(c){var d=CATS[c];return d.majors.map(function(m){return'<span class="tag">'+m+'</span>'}).join("")}
function card(n,act){var bc=["g","b",""][n.st];return'<article class="card"><span><span class="tag g">'+n.cat+'</span><span class="tag '+bc+'">'+ST[n.st]+'</span></span><h3>'+esc(n.title)+'</h3><p class="muted">'+esc(n.entity)+'</p>'+(n.uni?'<p class="muted">'+esc(n.uni)+' – '+esc(n.city||"")+'</p>':'')+'<p>'+esc(n.desc)+'</p><div><span class="muted">التخصصات المناسبة:</span> '+tags(n.cat)+'</div>'+(act?'<button class="btn" data-adopt="'+n.id+'"'+(n.st?' disabled':'')+'>'+(n.st?'تم تبنّيه':'أتبنّى هذا الاحتياج')+'</button>':'')+'</article>'}
var V={
home:function(){var n=needs[0],i=0;return'<section class="hero"><div><h1>من حاجة في المجتمع إلى مشروع في الجامعة</h1><button class="btn" data-go="submit">سجّل احتياجًا</button> <button class="btn alt" data-go="browse">تصفّح الاحتياجات</button></div></section>'
+'<h2 style="margin-top:28px">من يستطيع رفد هذا الاحتياج؟</h2><label style="max-width:420px">اختر احتياجًا لتعرف التخصصات القادرة على رفده<select id="pick">'+needs.map(function(x){return'<option value="'+x.id+'">'+esc(x.title)+'</option>'}).join("")+'</select></label><div id="demo"></div>'},
about:function(){return['<section class="abh"><h1>جسر بين احتياج المجتمع وقدرة الجامعة</h1><p>رفد منصة إلكترونية تجمع احتياجات الجهات المجتمعية في مكان واحد، وتوجّهها إلى التخصصات والطلاب القادرين على تلبيتها.</p></section>',
'<div class="ab2"><div class="col need"><h3>المشكلة</h3>الجامعات تملك خبرات وطاقات شابة، والمجتمع لديه احتياجات حقيقية، لكن لا توجد قناة منظمة تجمع بينهما.</div><div class="col cap"><h3>الحل</h3>منصة تسجّل الاحتياج، وتصنّفه، وتقترح التخصصات المناسبة، وتتابع تبنّيه حتى الإنجاز.</div></div>',
'<h2>رحلة الاحتياج</h2><div class="ab4"><div class="stp"><i>1</i><h3>يُسجَّل</h3><p class="muted">الجهة المجتمعية تكتب احتياجها.</p></div><div class="stp"><i>2</i><h3>يُصنَّف</h3><p class="muted">المنصة تحدد نوعه والتخصصات المناسبة.</p></div><div class="stp"><i>3</i><h3>يُتبَنّى</h3><p class="muted">الطلاب يختارون ما يناسبهم.</p></div><div class="stp"><i>4</i><h3>يُنجَز</h3><p class="muted">تُتابَع الحالة حتى النهاية.</p></div></div>',
'<h2>لمن هذه المنصة</h2><div class="ab3"><div class="col"><h3>الجهات المجتمعية</h3>تسجّل احتياجها وتعرف من يعمل عليه.</div><div class="col"><h3>الطلاب</h3>يجدون مشروعات حقيقية تناسب تخصصهم.</div><div class="col"><h3>الجامعة</h3>تتابع المؤشرات وتوجّه الدعم.</div></div>',
'<h2>مبادئ المسؤولية الاجتماعية</h2><div class="ab3"><div class="col cap"><h3>الشفافية</h3>حالة كل احتياج ظاهرة للجميع.</div><div class="col cap"><h3>العدالة</h3>الجهات الصغيرة تصل إلى الخبرة بلا كلفة.</div><div class="col cap"><h3>الخصوصية</h3>لا تُجمع بيانات أكثر مما يلزم.</div></div>',
'<button class="btn" data-go="submit">سجّل احتياجًا</button> <button class="btn alt" data-go="browse">تصفّح الاحتياجات</button>'].join("")},
about_old:function(){return'<h1>عن رفد</h1><p style="max-width:640px">رفد منصة إلكترونية تربط احتياجات المجتمع المحلي بالقدرات المتاحة في الجامعات من تخصصات ومهارات ومعارف.</p><h2>كيف تعمل</h2><ol style="max-width:640px;padding-inline-start:22px"><li>تسجّل الجهة المجتمعية احتياجها أو مشكلتها.</li><li>تصنّفها المنصة وتقترح التخصصات الجامعية المناسبة لها.</li><li>يطّلع الطلاب والجهات الأكاديمية على الاحتياجات ويتبنّون ما يناسب تخصصاتهم.</li><li>تُتابَع حالة الاحتياج حتى يُنجَز.</li></ol><h2>لمن؟</h2><p style="max-width:640px">للجهات المجتمعية التي تبحث عن حلول، وللطلاب الذين يريدون تطبيق ما تعلموه، ولإدارة الجامعة التي تتابع أثرها في المجتمع.</p>'},
submit:function(){return'<h1>سجّل احتياجًا</h1><p class="muted">اكتب المشكلة أو الاحتياج، وستقترح المنصة تصنيفه والتخصصات المرتبطة به.</p><form id="f"><label>اسم الجهة<input name="entity" required></label><div class="two"><label>الجامعة<input name="uni" placeholder="مثال: جامعة القصيم" required></label><label>المدينة<input name="city" placeholder="مثال: بريدة" required></label></div><label>عنوان الاحتياج<input name="title" required></label><label>وصف الاحتياج<textarea name="desc" rows="4" required></textarea></label><label>التصنيف<select name="cat"><option value="">تصنيف تلقائي</option>'+Object.keys(CATS).map(function(c){return'<option>'+c+'</option>'}).join("")+'</select></label><button class="btn" type="submit">أرسل الاحتياج</button></form><div id="out"></div>'},
browse:function(){return'<h1>الاحتياجات المتاحة</h1><div class="filters"><select id="fc" aria-label="التصنيف"><option value="">كل التصنيفات</option>'+Object.keys(CATS).map(function(c){return'<option>'+c+'</option>'}).join("")+'</select><select id="fs" aria-label="الحالة"><option value="">كل الحالات</option>'+ST.map(function(s,i){return'<option value="'+i+'">'+s+'</option>'}).join("")+'</select></div><div class="grid" id="list"></div>'},
stats:function(){var d=needs.length,cs=Object.keys(CATS),mx=Math.max.apply(null,cs.map(function(c){return needs.filter(function(n){return n.cat===c}).length}).concat([1]));
return'<h1>مؤشرات المنصة</h1><p class="muted">تساعد هذه الأرقام صنّاع القرار في معرفة أكثر الاحتياجات تكرارًا ونسبة ما أُنجز منها.</p><div class="stats"><div class="stat"><b>'+d+'</b>احتياج مسجّل</div>'+ST.map(function(s,i){return'<div class="stat"><b>'+needs.filter(function(n){return n.st===i}).length+'</b>'+s+'</div>'}).join("")+'</div><h2>الاحتياجات حسب التصنيف</h2>'+cs.map(function(c){var k=needs.filter(function(n){return n.cat===c}).length;return'<div class="row"><span>'+c+'</span><div class="track"><div class="fill" style="width:'+(k/mx*100)+'%"></div></div><b>'+k+'</b></div>'}).join("")+uniBlock()}};
function demo(){var sel=document.getElementById("pick");if(!sel)return;var n=needs.filter(function(x){return x.id==sel.value})[0];if(!n)return;var c=CATS[n.cat];
document.getElementById("demo").innerHTML='<div class="bridge"><div class="col need"><h3>احتياج المجتمع</h3><b>'+esc(n.title)+'</b><p class="muted">'+esc(n.entity)+'</p></div><div class="link" aria-hidden="true">⇄</div><div class="col cap"><h3>التخصصات القادرة على رفده</h3>'+tags(n.cat)+'<p style="margin-top:8px">'+c.skills.map(function(s){return'<span class="tag b">'+s+'</span>'}).join("")+'</p></div></div>'}
function uniBlock(){var m={};needs.forEach(function(n){var u=n.uni||"غير محددة";m[u]=m[u]||{a:0,d:0};if(n.st>=1)m[u].a++;if(n.st===2)m[u].d++});var l=Object.keys(m).sort(function(a,b){return m[b].a-m[a].a||m[b].d-m[a].d});var mx=Math.max.apply(null,l.map(function(u){return m[u].a}).concat([1]));
return'<h2 style="margin-top:28px">الجامعات الأكثر رفدًا</h2><p class="muted">حسب عدد الاحتياجات التي تبنّتها الجامعة أو أنجزتها.</p>'+l.map(function(u,i){return'<div class="row" style="grid-template-columns:130px 1fr 100px"><span>'+(i+1)+'. '+esc(u)+'</span><div class="track"><div class="fill" style="width:'+(m[u].a/mx*100)+'%"></div></div><b>'+m[u].a+' <small class="muted">('+m[u].d+' منجز)</small></b></div>'}).join("")}
var cur="home";
function show(v){cur=V[v]?v:"home";document.getElementById("app").innerHTML=V[cur]();
document.querySelectorAll("nav button").forEach(function(b){b.setAttribute("aria-current",b.dataset.v===cur)});
try{if(location.hash!=="#"+cur)history.replaceState(null,"","#"+cur)}catch(e){}
if(cur==="home"){document.getElementById("pick").onchange=demo;demo()}
if(cur==="browse"){var up=function(){var c=document.getElementById("fc").value,s=document.getElementById("fs").value;var l=needs.filter(function(n){return(!c||n.cat===c)&&(s===""||n.st==s)});document.getElementById("list").innerHTML=l.length?l.map(function(n){return card(n,true)}).join(""):'<p class="muted">لا توجد احتياجات بهذا الفلتر. غيّر التصنيف أو الحالة.</p>'};document.getElementById("fc").onchange=up;document.getElementById("fs").onchange=up;up()}
if(cur==="submit"){document.getElementById("f").onsubmit=function(e){e.preventDefault();var f=e.target,cat=f.cat.value||classify(f.title.value+" "+f.desc.value)||"إدارية";var n={id:Date.now(),entity:f.entity.value,uni:f.uni.value,city:f.city.value,title:f.title.value,desc:f.desc.value,cat:cat,st:0};needs.unshift(n);save();
document.getElementById("out").innerHTML='<div class="result"><b>تم تسجيل الاحتياج</b><p>صُنّف ضمن: '+cat+'. التخصصات المقترحة: '+tags(cat)+'</p></div>';f.reset();toast("تم تسجيل الاحتياج")}}}
document.addEventListener("click",function(e){var t=e.target.closest("[data-v],[data-go],[data-adopt]");if(!t)return;
if(t.dataset.v)show(t.dataset.v);else if(t.dataset.go)show(t.dataset.go);else{var n=needs.filter(function(x){return x.id==t.dataset.adopt})[0];if(n&&!n.st){n.st=1;save();toast("تم تبنّي الاحتياج، وأصبح قيد التنفيذ");show("browse")}}});
window.addEventListener("hashchange",function(){var h=location.hash.slice(1);if(h&&h!==cur)show(h)});
var h0="";try{h0=location.hash.slice(1)}catch(e){}
show(h0||"home");
var sp=document.getElementById("splash"),spDone=false;function closeSp(){if(spDone)return;spDone=true;sp.classList.add("out");setTimeout(function(){sp.hidden=true},900)}
sp.onclick=closeSp;setTimeout(closeSp,3400);
var users={},me=null,au=document.getElementById("auth"),ab=document.getElementById("abox");
try{users=JSON.parse(localStorage.getItem("rifd-users")||"{}")}catch(e){}
function hsh(s){try{return crypto.subtle.digest("SHA-256",new TextEncoder().encode("rifd:"+s)).then(function(h){return Array.from(new Uint8Array(h)).map(function(x){return x.toString(16).padStart(2,"0")}).join("")})}catch(e){return Promise.resolve(String(s.length)+s)}}
function who(){var w=document.getElementById("who");w.innerHTML=me?'<span class="muted">'+esc(me)+'</span><button class="lo" id="lo">خروج</button>':'';var l=document.getElementById("lo");if(l)l.onclick=function(){me=null;who();au.hidden=false;av("login")}}
function enter(n){me=n;au.hidden=true;who();show(cur)}
function fld(l,n,t,x){return'<label>'+l+'<input name="'+n+'" type="'+(t||"text")+'" required '+(x||"")+'></label>'}
function av(v,msg){var h;
if(v==="login")h='<h1>تسجيل الدخول</h1><form id="af" data-m="login">'+fld("البريد الإلكتروني","email","email",'autocomplete="email"')+fld("كلمة المرور","pw","password",'autocomplete="current-password"')+'<div class="aerr" role="alert" id="ae"></div><button class="btn wide" type="submit">دخول</button></form><div class="alinks"><button class="lnk" data-av="forgot">نسيت كلمة المرور؟</button><button class="lnk" data-av="register">إنشاء حساب جديد</button></div><div class="sep">أو</div><button class="btn ghost wide" id="guest">المتابعة كضيف</button>';
else if(v==="register")h='<h1>إنشاء حساب</h1><form id="af" data-m="register">'+fld("الاسم","name","text",'autocomplete="name"')+fld("البريد الإلكتروني","email","email",'autocomplete="email"')+fld("كلمة المرور (6 أحرف على الأقل)","pw","password",'minlength="6" autocomplete="new-password"')+fld("تأكيد كلمة المرور","pw2","password",'autocomplete="new-password"')+'<div class="aerr" role="alert" id="ae"></div><button class="btn wide" type="submit">إنشاء الحساب</button></form><div class="alinks"><button class="lnk" data-av="login">لدي حساب بالفعل</button></div><div class="sep">أو</div><button class="btn ghost wide" id="guest">المتابعة كضيف</button>';
else h='<h1>استعادة كلمة المرور</h1><p class="muted">أدخل بريدك الإلكتروني وسنرسل لك رابط إعادة التعيين.</p><form id="af" data-m="forgot">'+fld("البريد الإلكتروني","email","email",'autocomplete="email"')+'<div class="aerr" role="alert" id="ae"></div><button class="btn wide" type="submit">إرسال رابط الاستعادة</button></form><div class="alinks"><button class="lnk" data-av="login">العودة إلى تسجيل الدخول</button></div>';
ab.innerHTML=h;if(msg){document.getElementById("ae").textContent=msg}}
ab.addEventListener("click",function(e){var t=e.target.closest("[data-av],#guest");if(!t)return;if(t.id==="guest")enter("ضيف");else av(t.dataset.av)});
ab.addEventListener("submit",function(e){e.preventDefault();var f=e.target,m=f.dataset.m,em=f.email.value.trim().toLowerCase(),er=document.getElementById("ae");er.textContent="";
if(m==="forgot"){f.outerHTML='<div class="aok" role="status">إذا كان هذا البريد مسجّلًا لدينا فسيصلك رابط إعادة تعيين كلمة المرور.</div><p class="muted">نموذج أولي: لا يُرسَل بريد فعلي في هذه النسخة.</p>';return}
hsh(f.pw.value).then(function(h){
if(m==="register"){if(f.pw.value!==f.pw2.value){er.textContent="كلمتا المرور غير متطابقتين.";return}
if(users[em]){er.textContent="هذا البريد مسجّل مسبقًا. استخدم تسجيل الدخول.";return}
users[em]={n:f.name.value.trim(),h:h};try{localStorage.setItem("rifd-users",JSON.stringify(users))}catch(x){}enter(users[em].n)}
else{var u=users[em];if(!u||u.h!==h){er.textContent="البريد أو كلمة المرور غير صحيحة.";return}enter(u.n)}})});
av("login");
</script>
</body>
</html>
